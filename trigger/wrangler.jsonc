{
  // Timer that triggers the GitHub render (see worker.js).
  "name": "kindle-fridge-trigger",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // Twice an hour, UTC hours 03-21 so both GMT and BST daytimes are
    // covered; worker.js skips anything outside 04:45-21:00 London time.
    // The :50 run finishes well before the Kindle wakes at five past.
    "crons": ["20,50 3-21 * * *"]
  }
}
